# ntfy (defaults: server https://ntfy.sh, topic quinielas-alert)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=quinielas-alert

# Required for GET /api/alerts/test?token=...
ALERT_TEST_TOKEN=

# Optional but required on Vercel for persistent /api/cabezas state across cold starts.
# Link a Vercel KV store to the project; these vars are set automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
